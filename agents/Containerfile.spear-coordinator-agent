# spear-coordinator-agent for openshell sandboxes, same base image and
# shape as the reference's Containerfile.openshell.coordinator: iproute
# and nftables are genuinely needed inside the image, not optional, the
# openshell supervisor's own network policy enforcement depends on them
# being present in the sandbox's own filesystem.
#
# build in cluster:
#   oc start-build spear-coordinator-agent --from-dir=agents --wait -n spear-shield-agents

FROM registry.access.redhat.com/ubi9/python-312:latest

USER 0

RUN dnf install -y --nodocs iproute nftables && dnf clean all && rm -rf /var/cache/dnf

RUN install -d -o 1001 -g 0 -m 775 /sandbox
WORKDIR /sandbox

# mlflow-skinny, for the real in process tracing in main.py,
# PHASE3_PLAN.md section 4. installed as root, same as retrieval's own
# requirements.txt install below, before dropping to 1001
COPY spear-coordinator-agent/requirements.txt /sandbox/requirements.txt
RUN pip install --no-cache-dir -r /sandbox/requirements.txt

USER 1001

COPY --chown=1001:0 _shared/a2a_server.py /sandbox/a2a_server.py
COPY --chown=1001:0 _shared/http_client.py /sandbox/http_client.py
COPY --chown=1001:0 _shared/mlflow_tracing.py /sandbox/mlflow_tracing.py
COPY --chown=1001:0 spear-coordinator-agent/main.py /sandbox/main.py

ENV AGENT_PORT=8080 \
    PYTHONPATH=/sandbox \
    PATH="/opt/app-root/bin:${PATH}"

EXPOSE 8080

CMD ["python3", "/sandbox/main.py"]
